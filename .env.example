POSTGRES_USER=codehound
POSTGRES_PASSWORD=codehound_local
POSTGRES_DB=codehound

# Register a GitHub OAuth app; never expose these through VITE_ variables.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CODEHOUND_FRONTEND_URL=http://localhost:5173

# Optional outside Docker: defaults to data/codehound.db (SQLite).
# CODEHOUND_DATABASE_URL=postgresql+psycopg://codehound:codehound_local@localhost:5432/codehound

# Enable queued independent execution with an immutable trusted local Docker image ID.
# CODEHOUND_EXECUTION_IMAGE_ID=sha256:...
# Optional directory of operator-owned evaluation profiles (never a candidate checkout).
# CODEHOUND_PROFILE_DIR=/absolute/path/to/operator-profiles
