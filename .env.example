POSTGRES_USER=codehound
POSTGRES_PASSWORD=codehound_local
POSTGRES_DB=codehound

# Register a GitHub OAuth app; never expose these through VITE_ variables.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CODEHOUND_FRONTEND_URL=http://localhost:5173

# Optional shared OAuth sessions. Unset means one-process local memory storage.
# Supply a Fernet key from your secret manager; do not commit an actual key.
# All API workers must use the same key and database. Empty/invalid keys fail startup.
# CODEHOUND_SESSION_ENCRYPTION_KEY=<secret-fernet-key>

# Optional outside Docker: defaults to data/codehound.db (SQLite).
# CODEHOUND_DATABASE_URL=postgresql+psycopg://codehound:codehound_local@localhost:5432/codehound

# Enable queued independent execution with an immutable trusted local Docker image ID.
# CODEHOUND_EXECUTION_IMAGE_ID=sha256:...
# Optional directory of operator-owned evaluation profiles (never a candidate checkout).
# CODEHOUND_PROFILE_DIR=/absolute/path/to/operator-profiles

# Bound queued/running execution jobs; configure on the API process.
# CODEHOUND_MAX_PENDING_PER_ACCOUNT=5
# CODEHOUND_MAX_PENDING_EXECUTIONS=50

# Shared request admission windows; bounded independently of execution queue capacity.
# CODEHOUND_MUTATION_REQUEST_LIMIT=120
# CODEHOUND_OAUTH_REQUEST_LIMIT=20
# CODEHOUND_REQUEST_LIMIT_WINDOW_SECONDS=60
# CODEHOUND_REQUEST_LIMIT_MAX_BUCKETS=100000

# Logical retained-record admission bounds; these do not limit filesystem bytes.
# All statuses count. No history is deleted automatically when limits are reached.
# CODEHOUND_MAX_VERIFICATIONS_PER_ACCOUNT=1000
# CODEHOUND_MAX_VERIFICATIONS_TOTAL=50000
# CODEHOUND_MAX_EXECUTIONS_PER_ACCOUNT=1000
# CODEHOUND_MAX_EXECUTIONS_TOTAL=50000
