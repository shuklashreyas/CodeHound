{
  "id": "boltons-singular-double-s",
  "label": "boltons PR #418 singularize regression",
  "repository": "mahmoud/boltons",
  "coverage": "Reproduce corruption of already-singular ss-ending words in singularize; preserve case and representative existing plural handling. Single-s ambiguous words and linguistic completeness are outside this contract. Operator-owned JSON expectations stay outside the candidate process. Public edge cases are not secret tests. Historical upstream reproduction does not establish AI authorship, review ground truth, or full repository correctness.",
  "visible": {
    "schema_version": 1,
    "name": "boltons-singular-double-s-visible",
    "module": "boltons.strutils",
    "function": "singularize",
    "source_directory": ".",
    "result_encoding": "json",
    "timeout_seconds": 5,
    "cases": [
      {
        "id": "preserve-glass",
        "args": [
          "glass"
        ],
        "kwargs": {},
        "expect": {
          "kind": "value",
          "value": "glass"
        }
      },
      {
        "id": "plural-glasses",
        "args": [
          "glasses"
        ],
        "kwargs": {},
        "expect": {
          "kind": "value",
          "value": "glass"
        }
      },
