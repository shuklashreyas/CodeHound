{
  "id": "codehound-verdict-contract",
  "label": "CodeHound comparison verdict contract",
  "repository": "shuklashreyas/CodeHound",
  "coverage": "Checks aggregation of structured visible and independent outcomes: regression priority, unresolved checks, incomplete evidence, and improvement signals. Does not validate individual test execution, all comparison logic, or full issue requirements. Requires summarize_comparisons in both pinned revisions; a missing target is inconclusive. These cases are public dogfooding fixtures.",
  "visible": {
    "schema_version": 1,
    "module": "codehound.execution.results",
    "function": "summarize_comparisons",
    "source_directory": "backend/src",
    "timeout_seconds": 5,
    "name": "verdict-visible",
    "cases": [
      {
        "id": "unchanged-visible",
        "args": [
          {
            "visible": {
              "test_comparison": {
                "verdict": "no_behavior_change_observed",
                "improvements": [],
                "regressions": [],
                "unresolved": []
              }
            }
          }
        ],
        "expect": {
          "kind": "value",
          "value": {
            "verdict": "no_behavior_change_observed",
            "signals": [],
            "confidence": null
          }
        }
      },
      {
        "id": "visible-improvement",
        "args": [
          {
            "visible": {
              "test_comparison": {
                "verdict": "candidate_improves",
                "improvements": [
                  {
                    "nodeid": "one",
                    "before": "failed",
                    "after": "passed"
                  }
                ],
                "regressions": [],
                "unresolved": []
              }
            }
          }
        ],
        "expect": {
          "kind": "value",
          "value": {
            "verdict": "candidate_improves",
            "signals": [],
            "confidence": null
          }
        }
      },
      {
        "id": "visible-incomplete",
        "args": [
          {
            "visible": {
              "test_comparison": {
                "verdict": "incomplete",
                "improvements": [],
                "regressions": [],
                "unresolved": [
                  {
                    "nodeid": "three",
                    "before": "failed",
                    "after": "failed"
                  }
                ]
              }
            }
          }
        ],
        "expect": {
          "kind": "value",
          "value": {
            "verdict": "incomplete",
            "signals": [],
            "confidence": null
          }
        }
      }
    ]
  },
