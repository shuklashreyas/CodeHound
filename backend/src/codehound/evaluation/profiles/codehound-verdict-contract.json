  "requirements": [
    {
      "id": "basic-verdicts",
      "description": "Preserve visible improvement, unchanged behavior, and unresolved failures.",
      "cases": [
        {
          "suite": "visible",
          "case_id": "unchanged-visible"
        },
        {
          "suite": "visible",
          "case_id": "visible-improvement"
        },
        {
          "suite": "visible",
          "case_id": "visible-incomplete"
        }
      ]
    },
    {
      "id": "independent-priority",
      "description": "Independent regressions and unresolved failures override visible improvement and retain the corresponding signal.",
      "cases": [
        {
          "suite": "hidden",
          "case_id": "hidden-regression-dominates"
        },
        {
          "suite": "hidden",
          "case_id": "hidden-unresolved-dominates"
